# Shuttle Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Django Settings
# =============================================================================

# REQUIRED: Generate a unique secret key for production
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-this-to-a-strong-secret-key

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# =============================================================================
# Database Settings
# =============================================================================

# MySQL connection URL (used by docker-compose)
DATABASE_URL=mysql://shuttle:shuttle_password@db:3306/shuttle

# MySQL settings (used by docker-compose mysql container)
MYSQL_DATABASE=shuttle
MYSQL_USER=shuttle
MYSQL_PASSWORD=shuttle_password
MYSQL_ROOT_PASSWORD=shuttle_root_password

# =============================================================================
# Frontend URL (for magic links and emails)
# =============================================================================

FRONTEND_URL=http://localhost:5173

# =============================================================================
# CORS Settings
# =============================================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# =============================================================================
# Email Settings
# =============================================================================

# Email backend options:
#   - django.core.mail.backends.console.EmailBackend (dev - prints to console)
#   - django.core.mail.backends.smtp.EmailBackend (SMTP)
#   - accounts.email_backends.ScalewayEmailBackend (Scaleway TEM API)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Settings (when using smtp.EmailBackend)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Sender email
DEFAULT_FROM_EMAIL=noreply@shuttle.local

# Scaleway TEM Settings (when using ScalewayEmailBackend)
SCALEWAY_SECRET_KEY=
SCALEWAY_PROJECT_ID=
SCALEWAY_TEM_REGION=fr-par

# =============================================================================
# App Configuration
# =============================================================================

# Application title (shown in navbar and page title)
APP_TITLE=Shuttle

# =============================================================================
# Initial Admin User (optional)
# =============================================================================

# Set these to create an initial admin user on first startup
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME=Admin

# =============================================================================
# Discord Integration (optional)
# =============================================================================

# Webhook URL for driver departure notifications
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
